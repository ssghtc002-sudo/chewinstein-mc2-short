  "dialogue": [
    {
      "id": "line_01",
      "beatId": "beat_1_chalkboard_oops",
      "speaker": "narrator",
      "start": 0.22,
      "end": 2.40,
      "text": "One sneeze—and Chewinstein broke physics."
    },
    {
      "id": "line_02",
      "beatId": "beat_1_chalkboard_oops",
      "speaker": "chewinstein",
      "start": 2.55,
      "end": 4.40,
      "text": "Oops! What if E doesn't equal mc squared?"
    },
    {
      "id": "line_03",
      "beatId": "beat_2_speed_of_light_drop",
      "speaker": "narrator",
      "start": 4.65,
      "end": 7.15,
      "text": "First—light speed collapses like tired Wi-Fi!"
    },
    {
      "id": "line_04",
      "beatId": "beat_2_speed_of_light_drop",
      "speaker": "chewinstein",
      "start": 7.30,
      "end": 9.65,
      "text": "My lamp's photons are literally walking past me!"
    },
    {
      "id": "line_05",
      "beatId": "beat_3_mass_float_chaos",
      "speaker": "atom",
      "start": 9.95,
      "end": 12.60,
      "text": "Nice math, genius—now atoms can't pay energy bills!"
    },
    {
      "id": "line_06",
      "beatId": "beat_3_mass_float_chaos",
      "speaker": "narrator",
      "start": 12.75,
      "end": 14.85,
      "text": "Mass loses its power, and gravity goes wild!"
    },
    {
      "id": "line_07",
      "beatId": "beat_4_sun_goes_dim",
      "speaker": "narrator",
      "start": 15.10,
      "end": 17.65,
      "text": "Stars need fusion math to shine—no equation, no Sun!"
    },
    {
      "id": "line_08",
      "beatId": "beat_4_sun_goes_dim",
      "speaker": "chewinstein",
      "start": 17.80,
      "end": 20.05,
      "text": "Brrr! Even my Einstein hair is freezing!"
    },
    {
      "id": "line_09",
      "beatId": "beat_5_fixing_the_math",
      "speaker": "narrator",
      "start": 20.30,
      "end": 22.80,
      "text": "Until Chewinstein grabs gold chalk—and slams back equals!"
    },
    {
      "id": "line_10",
      "beatId": "beat_5_fixing_the_math",
      "speaker": "chewinstein",
      "start": 22.95,
      "end": 25.25,
      "text": "Boom! Mass equals pure glowing energy again!"
    },
    {
      "id": "line_11",
      "beatId": "beat_6_chewinstein_theory",
      "speaker": "narrator",
      "start": 25.55,
      "end": 27.60,
      "text": "So physics stays safe—mostly anyway."
    },
    {
      "id": "line_12",
      "beatId": "beat_6_chewinstein_theory",
      "speaker": "chewinstein",
      "start": 27.75,
      "end": 29.70,
      "text": "Actually... E equals mc squared, plus coffee!"
